.DS_Store
source/
data/raw/
repro/external/

# Local Python environment (multi-GB; rebuild from repro/requirements.txt)
.venv/
.worktrees/
__pycache__/
*.pyc

# Pipeline run log, regenerated by repro/benchmark/run_all_repro.sh
repro/run_all_repro.log

# Per-seed deep survey runs used to measure run-to-run variance.
# Untracked until we decide what to publish; the canonical single-seed results
# stay in repro/results/deep_survey.
repro/results/deep_survey_seed*/
repro/multiseed_deep.log
repro/canonical_qualitative_rerun.log

# Publish only the exact seed-17 prediction masks used by qualitative panels;
# keep the rest of each per-seed training bundle local.
!repro/results/deep_survey_seed17/
repro/results/deep_survey_seed17/*
!repro/results/deep_survey_seed17/canonical_predictions/
!repro/results/deep_survey_seed17/canonical_predictions/**

# Local manuscript files; not part of the public repository.
paper/
